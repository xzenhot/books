  "chapters": [
    {
      "chapter_index": 1,
      "name": "1",
      "word_target": 500,
      "chapter_title": "চুন লাগানো",
      "chapter_summary": "প্রতারণার প্রথম ভাষা — দোকানদার যেমন আলমারি কেনার সময় চুন লাগিয়ে দেয়, তেমনি এই প্রবাদ শেখায় যে বিশ্বাসের আড়ালে প্রতারণা লুকিয়ে থাকে।",
      "further_references": []
    },
    {
      "chapter_index": 2,
      "name": "2",
      "word_target": 500,
      "chapter_title": "টুপি পরানো",
      "chapter_summary": "সত্যকে ঢাকার ফন্দি — মাথায় টুপি পরিয়ে মিথ্যাকে সত্য সাজানো, যেখানে প্রতারক ঘুরে ঘুরে সবাইকে বোকা বানায়।",
      "further_references": []
    },
    {
      "chapter_index": 3,
      "name": "3",
      "word_target": 500,
      "chapter_title": "ঘোল খাওয়ানো",
      "chapter_summary": "অর্থহীন হয়রানি — সরকারি অফিসে এক কাগজের জন্য মাসের পর মাস ঘুরিয়ে দেওয়া, যেখানে কাজ হয় না, শুধু ঘোল খাওয়ানো হয়।",
      "further_references": []
    },
    {
      "chapter_index": 4,
      "name": "4",
      "word_target": 500,
      "chapter_title": "ল্যাজ গুটানো",
      "chapter_summary": "ভয়ের পলায়ন — পুলিশ দেখলেই গুণ্ডারা যেমন ল্যাজ গুটিয়ে পালায়, তেমনি ক্ষমতার সামনে সাহসের পতন।",
      "further_references": []
    },
    {
      "chapter_index": 5,
      "name": "5",
      "word_target": 500,
      "chapter_title": "ল্যাদ",
      "chapter_summary": "জীবনের সবচেয়ে বাংলা অনুভূতি — রবিবারের চরম আলস্য, যেখানে কাজ নয়, শুধু ল্যাদ খাওয়ার শিল্পই আসল।",
      "further_references": []
    },
    {
      "chapter_index": 6,
      "name": "6",
      "word_target": 500,
      "chapter_title": "আঁতেল",
      "chapter_summary": "মেকি পণ্ডিত — অকারণে জ্ঞান দেখিয়ে অন্যদের অবজ্ঞা করা, যেখানে বাক্যই হয়ে ওঠে ভান।",
      "further_references": []
    },
    {
      "chapter_index": 7,
      "name": "7",
      "word_target": 500,
      "chapter_title": "নাড়ু গোপাল",
      "chapter_summary": "ঘরের আদরের অকর্মণ্য — যে কোনো কাজ করে না, অথচ পরিবারের স্নেহে লালিত, আর কিছুই করতে পারে না।",
      "further_references": []
    },
    {
      "chapter_index": 8,
      "name": "8",
      "word_target": 500,
      "chapter_title": "গোবর গণেশ",
      "chapter_summary": "সম্পূর্ণ মূর্খ — গোবরের তৈরি গণেশের মতো যে মানুষ মূল্যহীন, অথচ পূজা পায়।",
      "further_references": []
    },
    {
      "chapter_index": 9,
      "name": "9",
      "word_target": 500,
      "chapter_title": "ফাটবাজ",
      "chapter_summary": "ফাঁকা আওয়াজ — বড়াই আর মিথ্যে দাবির মানুষ, যার কথায় শুধু ফাটাফাটি, কাজে কিছুই নেই।",
      "further_references": []
    },
    {
      "chapter_index": 10,
      "name": "10",
      "word_target": 500,
      "chapter_title": "ক্যাঁচাল",
      "chapter_summary": "দীর্ঘ জটিল বচসা — যে ঝামেলার শেষ নেই, যেখানে যুক্তি হারিয়ে শুধু ক্যাঁচালই বাড়ে।",
      "further_references": []
    },
    {
      "chapter_index": 11,
      "name": "11",
      "word_target": 500,
      "chapter_title": "ঢ্যাপ",
      "chapter_summary": "বড় মিথ্যা — যে কথা পুরোটাই ফাঁকা, একটি শব্দও সত্য নয়, শুধু ঢ্যাপ।",
      "further_references": []
    },
    {
      "chapter_index": 12,
      "name": "12",
      "word_target": 500,
      "chapter_title": "ঘ্যাঁট",
      "chapter_summary": "জগাখিচুড়ি ননসেন্স — সব মিলে গিয়ে কিছুই বোঝা যায় না, যেখানে অর্থ হারিয়ে শুধু ঘ্যাঁট রয়ে যায়।",
      "further_references": []
    },
    {
      "chapter_index": 13,
      "name": "13",
      "word_target": 500,
      "chapter_title": "পোকা মারা",
      "chapter_summary": "অকারণ বিরক্তি — কাজের সময় পোকা মারার মতো ছোট ছোট খোঁচা, যা ক্রমশ মাথা গরম করে।",
      "further_references": []
    },
    {
      "chapter_index": 14,
      "name": "14",
      "word_target": 500,
      "chapter_title": "ভাত মারা",
      "chapter_summary": "জীবিকা কেড়ে নেওয়া — গরিবের ভাত মারা, যেখানে একজনের ক্ষুধা আরেকজনের অপরাধ।",
      "further_references": []
    },
    {
      "chapter_index": 15,
      "name": "15",
      "word_target": 500,
      "chapter_title": "আমতা আমতা করা",
      "chapter_summary": "মিথ্যের তোতলামি — সত্য না বলে ইতস্তত করা, যেখানে নার্ভাস কথাই দোষ স্বীকার করে।",
      "further_references": []
    },
    {
      "chapter_index": 16,
      "name": "16",
      "word_target": 500,
      "chapter_title": "চালকি মারা",
      "chapter_summary": "অতি-চালাকির খেলা — ছোট ফন্দিতে সুবিধা নেওয়া, যেখানে ধরা পড়লেও লাভের লোভ থাকে।",
      "further_references": []
    },
    {
      "chapter_index": 17,
      "name": "17",
      "word_target": 500,
      "chapter_title": "হাওয়া খাওয়া",
      "chapter_summary": "উদ্দেশ্যহীন ঘোরা — সারাদিন হাওয়া খেয়ে বেড়ানো, যেখানে কিছুই হাতে আসে না।",
      "further_references": []
    },
    {
      "chapter_index": 18,
      "name": "18",
      "word_target": 500,
      "chapter_title": "ঘ্যাজ ঘ্যাজ",
      "chapter_summary": "অবিরাম ন্যাকা — সারাদিন ঘ্যাজ ঘ্যাজ করে অভিযোগ, যেখানে নীরবতা নেই, শুধু বিরক্তি।",
      "further_references": []
    },
    {
      "chapter_index": 19,
      "name": "19",
      "word_target": 500,
      "chapter_title": "তেল দেওয়া",
      "chapter_summary": "তোষামোদ — বসকে তেল দিয়ে পদোন্নতি আদায়, যেখানে মাখনের মতো চাটুকারিতা।",
      "further_references": []
    },
    {
      "chapter_index": 20,
      "name": "20",
      "word_target": 500,
      "chapter_title": "আড্ডা",
      "chapter_summary": "একটি সংস্কৃতি — চায়ের কাপে বন্ধুদের দীর্ঘ কথোপকথন, যেখানে সময় থেমে যায়।",
      "further_references": []
    },
    {
      "chapter_index": 21,
      "name": "21",
      "word_target": 500,
      "chapter_title": "বাঁশ দেওয়া",
      "chapter_summary": "সাবোটাজ — বন্ধুই বিপদে ফেলে, যেখানে বিশ্বাস ভেঙে বাঁশ দেওয়া হয়।",
      "further_references": []
    },
    {
      "chapter_index": 22,
      "name": "22",
      "word_target": 500,
      "chapter_title": "ধাপ্পা",
      "chapter_summary": "ফাঁকি আর ধোঁকা — যে প্রতিশ্রুতিতে চাকরি নেই, শুধু ধাপ্পা, আর কেউ কিছু পায় না।",
      "further_references": []
    },
    {
      "chapter_index": 23,
      "name": "23",
      "word_target": 500,
      "chapter_title": "পট্টি দেওয়া",
      "chapter_summary": "ব্রেইনওয়াশ — মিথ্যাকে সত্য বানিয়ে কাউকে বোকা বানানো, যেখানে মন ধোলাই হয়।",
      "further_references": []
    },
    {
      "chapter_index": 24,
      "name": "24",
      "word_target": 500,
      "chapter_title": "কাঁচকলা",
      "chapter_summary": "শূন্য ফল — এত পরিশ্রম, শেষে কিছুই না, শুধু কাঁচকলা, এক বড় শূন্য।",
      "further_references": []
    },
    {
      "chapter_index": 25,
      "name": "25",
      "word_target": 500,
      "chapter_title": "ঝামেলা",
      "chapter_summary": "নিরন্তর জট — যার সঙ্গে থাকা মানেই বিপদ, যেখানে শান্তি নেই, শুধু ঝামেলা।",
      "further_references": []
    },
    {
      "chapter_index": 26,
      "name": "26",
      "word_target": 500,
      "chapter_title": "গুলতানি",
      "chapter_summary": "অলস গুজব — কাজ নেই, শুধু ছোট ছোট গুলতানি, যেখানে সময় নষ্ট।",
      "further_references": []
    },
    {
      "chapter_index": 27,
      "name": "27",
      "word_target": 500,
      "chapter_title": "ফাঁকি",
      "chapter_summary": "দায়িত্ব এড়ানো — কাজে ফাঁকি দেওয়া, যেখানে দায়িত্বের পলায়নই স্বভাব।",
      "further_references": []
    },
    {
      "chapter_index": 28,
      "name": "28",
      "word_target": 500,
      "chapter_title": "পা-চাটা",
      "chapter_summary": "চাটুকার — নেতার পা চাটা, যেখানে মেরুদণ্ডহীন তোষামোদ।",
      "further_references": []
    },
    {
      "chapter_index": 29,
      "name": "29",
      "word_target": 500,
      "chapter_title": "গুল মারা",
      "chapter_summary": "আকাশকুসুম মিথ্যা — বড়াইয়ের গুল, যা কেউ বিশ্বাস করে না।",
      "further_references": []
    },
    {
      "chapter_index": 30,
      "name": "30",
      "word_target": 500,
      "chapter_title": "বান্ডেল",
      "chapter_summary": "নকল মানুষ — প্রথম শ্রেণির মিথ্যাবাদী, যার দাবির পিছনে কোনো সার নেই।",
      "further_references": []
    },
    {
      "chapter_index": 31,
      "name": "31",
      "word_target": 500,
      "chapter_title": "মাথা খাওয়া",
      "chapter_summary": "মানসিক জ্বালা — সকাল থেকে মাথা খেয়ে শেষ, যেখানে পীড়নের শেষ নেই।",
      "further_references": []
    },
    {
      "chapter_index": 32,
      "name": "32",
      "word_target": 500,
      "chapter_title": "কাণ্ড",
      "chapter_summary": "স্ক্যান্ডাল — গিয়ে যা কাণ্ডই করল, যেখানে পরিস্থিতি বিস্ফোরিত।",
      "further_references": []
    },
    {
      "chapter_index": 33,
      "name": "33",
      "word_target": 500,
      "chapter_title": "জগাখিচুড়ি",
      "chapter_summary": "সম্পূর্ণ বিশৃঙ্খলা — কাজ করতে গিয়ে জগাখিচুড়ি, যেখানে সব এলোমেলো।",
      "further_references": []
    },
    {
      "chapter_index": 34,
      "name": "34",
      "word_target": 500,
      "chapter_title": "সর্বনাশ",
      "chapter_summary": "সম্পূর্ণ ধ্বংস — এক বিস্ময়, যেখানে সব শেষ হয়ে যায়।",
      "further_references": []
    },
    {
      "chapter_index": 35,
      "name": "35",
      "word_target": 500,
      "chapter_title": "ধুর",
      "chapter_summary": "ক্ষোভের উচ্চারণ — আর ভালো লাগছে না, যেখানে ধৈর্যের সমাধি।",
      "further_references": []
    },
    {
      "chapter_index": 36,
      "name": "36",
      "word_target": 500,
      "chapter_title": "বোকারাম",
      "chapter_summary": "নির্বোধ — সরল ও বোকা, যাকে সহজেই ঠকানো যায়।",
      "further_references": []
    },
    {
      "chapter_index": 37,
      "name": "37",
      "word_target": 500,
      "chapter_title": "পোক্ত",
      "chapter_summary": "পাকা অভিজ্ঞ — চুরি করায় পোক্ত, যেখানে দক্ষতাই পুঁজি।",
      "further_references": []
    },
    {
      "chapter_index": 38,
      "name": "38",
      "word_target": 500,
      "chapter_title": "ছ্যামড়া",
      "chapter_summary": "বাজে যুবক — রাস্তায় বসে ল্যাদ খাওয়া ছ্যামড়া, যেখানে চরিত্রহীনতা।",
      "further_references": []
    },
    {
      "chapter_index": 39,
      "name": "39",
      "word_target": 500,
      "chapter_title": "ফাঁসানো",
      "chapter_summary": "ফাঁদে ফেলা — চোর বানিয়ে ফাঁসিয়ে দেওয়া, যেখানে মিথ্যে অভিযোগ।",
      "further_references": []
    },
    {
      "chapter_index": 40,
      "name": "40",
      "word_target": 500,
      "chapter_title": "ঘ্যাট",
      "chapter_summary": "নিকৃষ্ট — একেবারে ঘ্যাট সিনেমা, যেখানে গুণমানের তলানি।",
      "further_references": []
    },
    {
      "chapter_index": 41,
      "name": "41",
      "word_target": 500,
      "chapter_title": "আদিখ্যেতা",
      "chapter_summary": "অতিনাটকীয়তা — মেকি খুঁতখুঁতে, যেখানে কৃত্রিম স্নেহ সবাই জানে।",
      "further_references": []
    },
    {
      "chapter_index": 42,
      "name": "42",
      "word_target": 500,
      "chapter_title": "লেঙি মারা",
      "chapter_summary": "বিশ্বাসঘাতকতা — পদোন্নতির মুখে বন্ধুই লেঙি মারে, যেখানে পতন নিশ্চিত।",
      "further_references": []
    },
    {
      "chapter_index": 43,
      "name": "43",
      "word_target": 500,
      "chapter_title": "গ্যাম",
      "chapter_summary": "ব্যক্তিত্বের আভা — ছেলেটার গ্যাম আছে, যেখানে উপস্থিতিই শক্তি।",
      "further_references": []
    },
    {
      "chapter_index": 44,
      "name": "44",
      "word_target": 500,
      "chapter_title": "ক্ষীর খা",
      "chapter_summary": "আত্মপ্রশংসা — নিজের কাজে নিজেই ক্ষীর খাওয়া, যেখানে আত্মতৃপ্তি।",
      "further_references": []
    },
    {
      "chapter_index": 45,
      "name": "45",
      "word_target": 500,
      "chapter_title": "চাবুক",
      "chapter_summary": "তীক্ষ্ণ ও চমৎকার — প্রশ্নগুলো একেবারে চাবুক, যেখানে ধারালো বুদ্ধি।",
      "further_references": []
    },
    {
      "chapter_index": 46,
      "name": "46",
      "word_target": 500,
      "chapter_title": "কেস খাওয়া",
      "chapter_summary": "বিপদে পড়া — অফিসে দেরি করে কেস খাওয়া, যেখানে জটে জড়ানো।",
      "further_references": []
    },
    {
      "chapter_index": 47,
      "name": "47",
      "word_target": 500,
      "chapter_title": "সাংঘাতিক",
      "chapter_summary": "তীব্র — আজ সাংঘাতিক গরম, যেখানে মাত্রার চরম।",
      "further_references": []
    },
    {
      "chapter_index": 48,
      "name": "48",
      "word_target": 500,
      "chapter_title": "লে হালুয়া",
      "chapter_summary": "সর্বনাশের বিস্ময় — শেষ মুহূর্তে বৃষ্টিতে সব লে হালুয়া, যেখানে পরিকল্পনা ভেস্তে যায়।",
      "further_references": []
    },
    {
      "chapter_index": 49,
      "name": "49",
      "word_target": 500,
      "chapter_title": "বিচ্ছিরি",
      "chapter_summary": "কদর্য — এমন বিচ্ছিরি আবহাওয়া, যেখানে বেরোনোই যায় না।",
      "further_references": []
    },
    {
      "chapter_index": 50,
      "name": "50",
      "word_target": 500,
      "chapter_title": "চোরের মায়ের বড় গলা",
      "chapter_summary": "অপরাধীর আওয়াজ — নিজে ভুল করে আমায় বকছে, যেখানে দোষীর গলা সবচেয়ে চড়া।",
      "further_references": []
    },
    {
      "chapter_index": 51,
      "name": "51",
      "word_target": 500,
      "chapter_title": "বোমকে যাওয়া",
      "chapter_summary": "স্তব্ধ হয়ে যাওয়া — কাজের কথা বলতেই বোমকে গেল, যেখানে এড়িয়ে যাওয়া।",
      "further_references": []
    },
    {
      "chapter_index": 52,
      "name": "52",
      "word_target": 500,
      "chapter_title": "ফাঁসা",
      "chapter_summary": "আটকে পড়া — ট্র্যাফিকে ফেঁসে যাওয়া, যেখানে মুক্তি নেই।",
      "further_references": []
    },
    {
      "chapter_index": 53,
      "name": "53",
      "word_target": 500,
      "chapter_title": "ব্যাপক",
      "chapter_summary": "বিশাল — প্যান্ডালটা ব্যাপক, যেখানে স্কেলের বিস্ময়।",
      "further_references": []
    },
    {
      "chapter_index": 54,
      "name": "54",
      "word_target": 500,
      "chapter_title": "খাপে খাপ",
      "chapter_summary": "নিখুঁত মিল — জামাটা খাপে খাপ, যেখানে সব ঠিক।",
      "further_references": []
    },
    {
      "chapter_index": 55,
      "name": "55",
      "word_target": 500,
      "chapter_title": "আপনি বাঁচলে বাপের নাম",
      "chapter_summary": "আত্মরক্ষা প্রথম — নিজে বাঁচলে তবেই বংশের নাম, যেখানে আত্মরক্ষাই ধর্ম।",
      "further_references": []
    },
    {
      "chapter_index": 56,
      "name": "56",
      "word_target": 500,
      "chapter_title": "এক হাতে তালি বাজে না",
      "chapter_summary": "দুপক্ষের দোষ — শুধু ওর দোষ নয়, যেখানে দ্বন্দ্বে দুই হাত লাগে।",
      "further_references": []
    },
    {
      "chapter_index": 57,
      "name": "57",
      "word_target": 500,
      "chapter_title": "অতি লোভে তাঁতি নষ্ট",
      "chapter_summary": "লোভের ধ্বংস — বেশি লাভের আশা নয়, যেখানে লোভেই সর্বনাশ।",
      "further_references": []
    },
    {
      "chapter_index": 58,
      "name": "58",
      "word_target": 500,
      "chapter_title": "হ্যাঁজানো",
      "chapter_summary": "বিরক্তিকর বকবক — অযথা হ্যাঁজাস না, যেখানে মূলকথা হারিয়ে যায়।",
      "further_references": []
    },
    {
      "chapter_index": 59,
      "name": "59",
      "word_target": 500,
      "chapter_title": "ছড়ানো",
      "chapter_summary": "এলোমেলো করা — ইন্টারভিউতে গিয়ে সব ছড়িয়ে দিল, যেখানে গোছানো ব্যর্থ।",
      "further_references": []
    },
    {
      "chapter_index": 60,
      "name": "60",
      "word_target": 500,
      "chapter_title": "লোড নেওয়া",
      "chapter_summary": "টেনশন নেওয়া — এত লোড নিও না, যেখানে দুশ্চিন্তাই শত্রু।",
      "further_references": []
    },
    {
      "chapter_index": 61,
      "name": "61",
      "word_target": 500,
      "chapter_title": "সেয়ানে সেয়ানে",
      "chapter_summary": "দুই ধূর্তের লড়াই — যেখানে সমান বুদ্ধির সংঘর্ষ, আর কেউ হার মানে না।",
      "further_references": []
    },
    {
      "chapter_index": 62,
      "name": "62",
      "word_target": 500,
      "chapter_title": "গুটি সাজানো",
      "chapter_summary": "কৌশলের বিন্যাস — পদোন্নতির জন্য দিনের পর দিন গুটি সাজানো, যেখানে ধৈর্যই চাল।",
      "further_references": []
    },
    {
      "chapter_index": 63,
      "name": "63",
      "word_target": 500,
      "chapter_title": "কাঁটা দিয়ে কাঁটা তোলা",
      "chapter_summary": "শত্রু দিয়ে শত্রু নাশ — যেখানে আগুনে আগুন নেভানো হয়।",
      "further_references": []
    },
    {
      "chapter_index": 64,
      "name": "64",
      "word_target": 500,
      "chapter_title": "ঘাটে ঘাটে জল খাওয়া",
      "chapter_summary": "পোড় খাওয়া অভিজ্ঞ — যে সব ঘাটের জল খেয়েছে, তাকে ঠকানো যায় না।",
      "further_references": []
    },
    {
      "chapter_index": 65,
      "name": "65",
      "word_target": 500,
      "chapter_title": "অতি ভক্তি চোরের লক্ষণ",
      "chapter_summary": "অতিরিক্ত বিনয়ের সতর্কতা — এত তেল দিচ্ছে কেন, যেখানে চাটুকারিতাই চুরির চিহ্ন।",
      "further_references": []
    },
    {
      "chapter_index": 66,
      "name": "66",
      "word_target": 500,
      "chapter_title": "চাচা আপন প্রাণ বাঁচা",
      "chapter_summary": "নিজের প্রাণ বাঁচানো — বিপদে সবাই আগে নিজেকে বাঁচায়, যেখানে আত্মরক্ষার মন্ত্র।",
      "further_references": []
    },
    {
      "chapter_index": 67,
      "name": "67",
      "word_target": 500,
      "chapter_title": "দাঁতে দাঁত চেপে লড়া",
      "chapter_summary": "দৃঢ় সংগ্রাম — ব্যথা চেপে লড়াই, যেখানে জেদই শেষ কথা।",
      "further_references": []
    },
    {
      "chapter_index": 68,
      "name": "68",
      "word_target": 500,
      "chapter_title": "ঠেলায় না পড়লে বিড়াল গাছে ওঠে না",
      "chapter_summary": "চাপের উদ্ভাবন — প্রয়োজনই মানুষকে অসম্ভব করতে বাধ্য করে।",
      "further_references": []
    },
    {
      "chapter_index": 69,
      "name": "69",
      "word_target": 500,
      "chapter_title": "বুকের পাটা",
      "chapter_summary": "সাহস — নেতার সামনে কথা বলার বুকের পাটা, যেখানে নির্ভীকতা।",
      "further_references": []
    },
    {
      "chapter_index": 70,
      "name": "70",
      "word_target": 500,
      "chapter_title": "ঘাটের মড়া",
      "chapter_summary": "পাকা টিকে থাকা — ভয় দেখিয়ে লাভ নেই, যেখানে অভিজ্ঞতাই বর্ম।",
      "further_references": []
    },
    {
      "chapter_index": 71,
      "name": "71",
      "word_target": 500,
      "chapter_title": "জলে কুমির ডাঙায় বাঘ",
      "chapter_summary": "দুই দিকেই বিপদ — চাকরি ছাড়লেও বিপদ, রাখলেও, যেখানে ফাঁদ সর্বত্র।",
      "further_references": []
    },
    {
      "chapter_index": 72,
      "name": "72",
      "word_target": 500,
      "chapter_title": "চোখ খোলা রাখা",
      "chapter_summary": "সতর্কতা — টিকতে হলে চোখ খোলা রাখতে হবে, যেখানে সজাগ থাকাই বাঁচা।",
      "further_references": []
    },
    {
      "chapter_index": 73,
      "name": "73",
      "word_target": 500,
      "chapter_title": "হাটে হাঁড়ি ভাঙা",
      "chapter_summary": "প্রকাশ্য ফাঁস — সবার সামনে গোপন কৌশল ফাঁস, যেখানে শত্রু নিরস্ত্র।",
      "further_references": []
    },
    {
      "chapter_index": 74,
      "name": "74",
      "word_target": 500,
      "chapter_title": "নিজের চরকায় তেল দেওয়া",
      "chapter_summary": "নিজের কাজে মন — পরের ঝামেলায় না গিয়ে নিজের চাকা ঘোরানো।",
      "further_references": []
    },
    {
      "chapter_index": 75,
      "name": "75",
      "word_target": 500,
      "chapter_title": "ঠকে শেখা",
      "chapter_summary": "অভিজ্ঞতায় শিক্ষা — ঠকে শিখেছি, আর ভুল হবে না, যেখানে ব্যথাই গুরু।",
      "further_references": []
    },
    {
      "chapter_index": 76,
      "name": "76",
      "word_target": 500,
      "chapter_title": "গলা কাটা প্রতিযোগিতা",
      "chapter_summary": "নির্মম প্রতিযোগিতা — বাজারে গলা কাটা লড়াই, যেখানে শুধু নির্দয় টিকে।",
      "further_references": []
    },
    {
      "chapter_index": 77,
      "name": "77",
      "word_target": 500,
      "chapter_title": "শক্তির লড়াই",
      "chapter_summary": "ক্ষমতার সংঘর্ষ — নীতির নয়, শুধু শক্তির লড়াই, যেখানে জোরই ধর্ম।",
      "further_references": []
    },
    {
      "chapter_index": 78,
      "name": "78",
      "word_target": 500,
      "chapter_title": "বেড়ায় খেত খাওয়া",
      "chapter_summary": "রক্ষকের বিশ্বাসঘাতকতা — বেড়াই যখন খেত খায়, তখন কাকে বিশ্বাস করব।",
      "further_references": []
    },
    {
      "chapter_index": 79,
      "name": "79",
      "word_target": 500,
      "chapter_title": "পাকা মাথা",
      "chapter_summary": "ধূর্ত বুদ্ধি — এর পিছনে কোনো পাকা মাথা আছে, যেখানে চালাকি।",
      "further_references": []
    },
    {
      "chapter_index": 80,
      "name": "80",
      "word_target": 500,
      "chapter_title": "চোখে ধুলো দেওয়া",
      "chapter_summary": "চালাকিতে প্রতারণা — পুলিশের চোখে ধুলো দিয়ে পালানো, যেখানে ধোঁকা।",
      "further_references": []
    },
    {
      "chapter_index": 81,
      "name": "81",
      "word_target": 500,
      "chapter_title": "রুই-কাতলা",
      "chapter_summary": "বড় মাছ — ক্ষমতাবানদের কাছে ছোট মাছের কথা কে শোনে, যেখানে স্তরবিন্যাস।",
      "further_references": []
    },
    {
      "chapter_index": 82,
      "name": "82",
      "word_target": 500,
      "chapter_title": "পুরনো পাপী",
      "chapter_summary": "পাকা খেলোয়াড় — পুরনো পাপীকে ফাঁকি দেওয়া যায় না, যেখানে অভিজ্ঞতাই জাল।",
      "further_references": []
    },
    {
      "chapter_index": 83,
      "name": "83",
      "word_target": 500,
      "chapter_title": "ঘুঘু",
      "chapter_summary": "ধূর্ত শিকারী — ঘুঘু কখন কোন ফাঁদ পাতল কেউ জানে না, যেখানে চতুরতা।",
      "further_references": []
    },
    {
      "chapter_index": 84,
      "name": "84",
      "word_target": 500,
      "chapter_title": "ঘাটের পোকা",
      "chapter_summary": "জায়গার পাকা লোক — অফিসের ঘাটের পোকা জানে কাকে তেল দিতে হয়, যেখানে অন্তর্জ্ঞান।",
      "further_references": []
    },
    {
      "chapter_index": 85,
      "name": "85",
      "word_target": 500,
      "chapter_title": "কাঁধে বন্দুক রাখা",
      "chapter_summary": "পরের কাঁধে শিকার — নিজে কিছু না করে অন্যের কাঁধে বন্দুক রেখে লাভ।",
      "further_references": []
    },
    {
      "chapter_index": 86,
      "name": "86",
      "word_target": 500,
      "chapter_title": "হাওয়া বুঝে চলা",
      "chapter_summary": "সুযোগের পাল — যে হাওয়া বুঝে চলে, সে প্রত্যেক সরকারে টিকে, যেখানে নমনীয়তা।",
      "further_references": []
    },
    {
      "chapter_index": 87,
      "name": "87",
      "word_target": 500,
      "chapter_title": "নিজের আটি রাখা",
      "chapter_summary": "নিজের স্বার্থ আগে — আগে নিজের আটি রাখো, তারপর পরোপকার, যেখানে স্বার্থই ভিত্তি।",
      "further_references": []
    },
    {
      "chapter_index": 88,
      "name": "88",
      "word_target": 500,
      "chapter_title": "খুঁটির জোরে লাফানো",
      "chapter_summary": "প্রভাবের বল — কোন খুঁটির জোরে লাফাচ্ছ জানি, যেখানে পিছনের পৃষ্ঠপোষক।",
      "further_references": []
    },
    {
      "chapter_index": 89,
      "name": "89",
      "word_target": 500,
      "chapter_title": "কান খাড়া রাখা",
      "chapter_summary": "সতর্ক শ্রবণ — বাজারে টিকতে কান খাড়া রাখতে হয়, যেখানে গুজবই সংকেত।",
      "further_references": []
    },
    {
      "chapter_index": 90,
      "name": "90",
      "word_target": 500,
      "chapter_title": "মাথা ঠান্ডা রাখা",
      "chapter_summary": "সংযম — বিপদে মাথা ঠান্ডা রাখাই আসল কাজ, যেখানে শান্তিই কৌশল।",
      "further_references": []
    },
    {
      "chapter_index": 91,
      "name": "91",
      "word_target": 500,
      "chapter_title": "পা টিপে চলা",
      "chapter_summary": "সাবধানে চলা — পরিস্থিতি খারাপ, পা টিপে চলতে হবে, যেখানে প্রতিটি পদক্ষেপ গণনা।",
      "further_references": []
    },
    {
      "chapter_index": 92,
      "name": "92",
      "word_target": 500,
      "chapter_title": "নদীর চরা",
      "chapter_summary": "অস্থির বিশ্বাস — নদীর চরার মতো যে বদলায়, তাকে বিশ্বাস করা যায় না।",
      "further_references": []
    },
    {
      "chapter_index": 93,
      "name": "93",
      "word_target": 500,
      "chapter_title": "ধনুর্ভঙ্গ পণ",
      "chapter_summary": "অটল সংকল্প — চাকরি পাবই, এ আমার ধনুর্ভঙ্গ পণ, যেখানে প্রতিজ্ঞা।",
      "further_references": []
    },
    {
      "chapter_index": 94,
      "name": "94",
      "word_target": 500,
      "chapter_title": "কেল্লা ফতে",
      "chapter_summary": "বিজয়ের ঘোষণা — ডিল পেলে কেল্লা ফতে, যেখানে জয় নিশ্চিত।",
      "further_references": []
    },
    {
      "chapter_index": 95,
      "name": "95",
      "word_target": 500,
      "chapter_title": "বুকে পাষাণ বাঁধা",
      "chapter_summary": "হৃদয়ে কঠোরতা — ভবিষ্যতের জন্য বুকে পাষাণ বেঁধে বাড়ি ছাড়া, যেখানে ত্যাগ।",
      "further_references": []
    },
    {
      "chapter_index": 96,
      "name": "96",
      "word_target": 500,
      "chapter_title": "হাত সাফ করা",
      "chapter_summary": "পরিচ্ছন্ন কাজ — সুযোগ পেয়েই হাত সাফ, যেখানে দ্রুত সম্পন্ন।",
      "further_references": []
    },
    {
      "chapter_index": 97,
      "name": "97",
      "word_target": 500,
      "chapter_title": "দুধে-ভাতে থাকা",
      "chapter_summary": "স্বাচ্ছন্দ্য — সন্তান দুধে-ভাতে থাকুক, যেখানে সমৃদ্ধিই কামনা।",
      "further_references": []
    },
    {
      "chapter_index": 98,
      "name": "98",
      "word_target": 500,
      "chapter_title": "গলা কাটা",
      "chapter_summary": "নির্মম দাম — দোকানদার গলা কাটা দাম নিচ্ছে, যেখানে নির্দয়তা।",
      "further_references": []
    },
    {
      "chapter_index": 99,
      "name": "99",
      "word_target": 500,
      "chapter_title": "তেল-নুন-লাকড়ি",
      "chapter_summary": "জীবনের মূল — সারা জীবন তেল-নুন-লাকড়ির জোগাড়ে, যেখানে মৌলিক সংগ্রাম।",
      "further_references": []
    },
    {
      "chapter_index": 100,
      "name": "100",
      "word_target": 500,
      "chapter_title": "শহরের পোকা",
      "chapter_summary": "শহুরে ধূর্ত — শহরের পোকাকে কেউ ঠকাতে পারে না, যেখানে রাস্তার অভিজ্ঞতা।",
      "further_references": []
    }
  ],
