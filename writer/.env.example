# Writer workspace environment
#
# Copy to `.env` (git-ignored) and fill in. Every Python entry point loads this
# file through tools/env.py; real environment variables take precedence.
#
# Show what is loaded:
#   python tools/env.py

# --- Search providers (tools/search/providers/) ------------------------------
# Provider used when a tool does not pass `backend` explicitly.
DEFAULT_SEARCH_PROVIDER=searxng

# SearXNG instance used by the default provider.
SEARCHXNG_DEV_URL=https://searx.be
# SEARCHXNG_URL=            # fallback alias for the same setting

# Optional paid providers — only needed if DEFAULT_SEARCH_PROVIDER selects them.
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# --- Facebook Pages MCP server (tools/mcpbangla/mcpfacebook/) ----------------
# Long-lived user token with pages_manage_posts, pages_read_engagement and
# pages_manage_engagement.
FB_USER_ACCESS_TOKEN=
# App secret — enables appsecret_proof request signing.
FB_APP_SECRET=
# Graph API version and request timeout.
FB_GRAPH_VERSION=v21.0
FB_TIMEOUT=30
