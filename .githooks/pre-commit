#!/bin/sh
# Fail the commit when a generated MCP config no longer matches the canonical
# .vscode/mcp.json. Enable once per clone:
#   git config core.hooksPath .githooks
repo_root=$(git rev-parse --show-toplevel)
python "$repo_root/writer/tools/mcp_sync.py" check || {
    echo ""
    echo "MCP configs drifted. Edit writer/.vscode/mcp.json, then run:"
    echo "  python writer/tools/mcp_sync.py sync"
    exit 1
}
