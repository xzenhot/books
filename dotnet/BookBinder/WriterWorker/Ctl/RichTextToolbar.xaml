<UserControl x:Class="WriterWorker.Ctl.RichTextToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FontFamily="Segoe UI"
             FontSize="12"
             Foreground="{DynamicResource TextBrush}"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>

        <ControlTemplate x:Key="ToolItemTemplate" TargetType="ButtonBase">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template" Value="{StaticResource ToolItemTemplate}" />
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template" Value="{StaticResource ToolItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="Fill" Value="{DynamicResource PanelBorderBrush}" />
        </Style>

        <Style x:Key="ToolCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        </Style>

        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                Background="{Binding}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaletteAutoButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="AlignLeftGeometry">M1,2 H13 M1,6 H9 M1,10 H13 M1,14 H9</Geometry>
        <Geometry x:Key="AlignCenterGeometry">M1,2 H13 M3,6 H11 M1,10 H13 M3,14 H11</Geometry>
        <Geometry x:Key="AlignRightGeometry">M1,2 H13 M5,6 H13 M1,10 H13 M5,14 H13</Geometry>
        <Geometry x:Key="AlignJustifyGeometry">M1,2 H13 M1,6 H13 M1,10 H13 M1,14 H13</Geometry>

        <Style x:Key="AlignIcon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource SideBarBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="6,4">
        <Grid>
            <WrapPanel x:Name="ToolbarPanel" Orientation="Horizontal">

                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click">
                    <TextBlock Text="&#x21B6;" FontSize="14" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click">
                    <TextBlock Text="&#x21B7;" FontSize="14" />
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <Button x:Name="CutButton" Style="{StaticResource ToolButton}" ToolTip="Cut (Ctrl+X)" Click="Cut_Click">
                    <TextBlock Text="&#x2702;" FontSize="12" />
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" ToolTip="Copy (Ctrl+C)" Click="Copy_Click">
                    <TextBlock Text="&#x29C9;" FontSize="13" />
                </Button>
                <Button x:Name="PasteButton" Style="{StaticResource ToolButton}" ToolTip="Paste (Ctrl+V)" Click="Paste_Click">
                    <Path Width="13" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                          Data="M4,2.5 H10 M3.5,4 H10.5 V14 H3.5 Z M5.5,1 H8.5 V3.5 H5.5 Z" />
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <ComboBox x:Name="FontFamilyBox"
                          Style="{StaticResource ToolCombo}"
                          Width="160"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          ToolTip="Font family"
                          SelectionChanged="FontFamily_SelectionChanged"
                          DropDownOpened="FontFamily_DropDownOpened"
                          KeyDown="FontFamily_KeyDown"
                          LostFocus="FontFamily_LostFocus" />
                <ComboBox x:Name="FontSizeBox"
                          Style="{StaticResource ToolCombo}"
                          Width="58"
                          IsEditable="True"
                          ToolTip="Font size"
                          SelectionChanged="FontSize_SelectionChanged"
                          KeyDown="FontSize_KeyDown"
                          LostFocus="FontSize_LostFocus" />
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggle}" ToolTip="Bold (Ctrl+B)" Click="Bold_Click">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggle}" ToolTip="Italic (Ctrl+I)" Click="Italic_Click">
                    <TextBlock Text="I" FontStyle="Italic" FontFamily="Cambria" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToolToggle}" ToolTip="Underline (Ctrl+U)" Click="Underline_Click">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToolToggle}" ToolTip="Strikethrough" Click="Strike_Click">
                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="13" />
                </ToggleButton>
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <Button x:Name="FontColorButton" Style="{StaticResource ToolButton}" Width="30" ToolTip="Font color" Click="FontColorButton_Click">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="12" HorizontalAlignment="Center" />
                        <Border x:Name="FontColorBar" Height="3" Width="16" Margin="0,1,0,0" CornerRadius="1" Background="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="HighlightButton" Style="{StaticResource ToolButton}" Width="30" ToolTip="Highlight color" Click="HighlightButton_Click">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="ab" FontSize="11" HorizontalAlignment="Center" />
                        <Border x:Name="HighlightBar" Height="3" Width="16" Margin="0,1,0,0" CornerRadius="1" Background="Transparent" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource ToolToggle}" ToolTip="Align left" Click="Align_Click">
                    <Path Style="{StaticResource AlignIcon}" Data="{StaticResource AlignLeftGeometry}" />
                </ToggleButton>
                <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource ToolToggle}" ToolTip="Center" Click="Align_Click">
                    <Path Style="{StaticResource AlignIcon}" Data="{StaticResource AlignCenterGeometry}" />
                </ToggleButton>
                <ToggleButton x:Name="AlignRightButton" Style="{StaticResource ToolToggle}" ToolTip="Align right" Click="Align_Click">
                    <Path Style="{StaticResource AlignIcon}" Data="{StaticResource AlignRightGeometry}" />
                </ToggleButton>
                <ToggleButton x:Name="AlignJustifyButton" Style="{StaticResource ToolToggle}" ToolTip="Justify" Click="Align_Click">
                    <Path Style="{StaticResource AlignIcon}" Data="{StaticResource AlignJustifyGeometry}" />
                </ToggleButton>
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <Button x:Name="BulletsButton" Style="{StaticResource ToolButton}" ToolTip="Bulleted list" Click="Bullets_Click">
                    <TextBlock Text="&#x2022;" FontSize="15" />
                </Button>
                <Button x:Name="NumberingButton" Style="{StaticResource ToolButton}" ToolTip="Numbered list" Click="Numbering_Click">
                    <TextBlock Text="1." FontSize="11" FontWeight="SemiBold" />
                </Button>
                <Button x:Name="IndentButton" Style="{StaticResource ToolButton}" ToolTip="Increase indent" Click="Indent_Click">
                    <TextBlock Text="&#x21E5;" FontSize="13" />
                </Button>
                <Button x:Name="OutdentButton" Style="{StaticResource ToolButton}" ToolTip="Decrease indent" Click="Outdent_Click">
                    <TextBlock Text="&#x21E4;" FontSize="13" />
                </Button>
                <Rectangle Style="{StaticResource ToolSeparator}" />

                <Button x:Name="ClearFormattingButton" Style="{StaticResource ToolButton}" Width="Auto" Padding="6,0" ToolTip="Clear all formatting" Click="ClearFormatting_Click">
                    <TextBlock Text="Clear" FontSize="11" />
                </Button>

            </WrapPanel>

            <Popup x:Name="FontColorPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=FontColorButton}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource SideBarBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6">
                    <StackPanel>
                        <Button Content="Automatic" Style="{StaticResource PaletteAutoButton}" Click="FontColor_Click" />
                        <ItemsControl x:Name="FontColorPalette" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PaletteButton}" Tag="{Binding}" Click="FontColor_Click" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="HighlightPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=HighlightButton}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource SideBarBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6">
                    <StackPanel>
                        <Button Content="No color" Style="{StaticResource PaletteAutoButton}" Click="Highlight_Click" />
                        <ItemsControl x:Name="HighlightPalette" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PaletteButton}" Tag="{Binding}" Click="Highlight_Click" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
