<UserControl x:Class="WriterWorker.Ctl.RichTextExportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <DockPanel>
                <Button x:Name="ExportPdfButton"
                        DockPanel.Dock="Right"
                        Content="Export PDF..."
                        ToolTip="Save the document as a PDF file"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnExportPdfClick" />
                <Button x:Name="ExportButton"
                        DockPanel.Dock="Right"
                        Content="Export RTF..."
                        ToolTip="Save the document as an RTF file (Ctrl+S)"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnExportClick" />
                <TextBlock Text="{Binding DocumentName, ElementName=Root}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="10,4"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Border>

        <RichTextBox x:Name="EditorBox"
                     AcceptsTab="True"
                     AllowDrop="True"
                     SpellCheck.IsEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="12"
                     BorderThickness="0"
                     Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                     Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                     PreviewKeyDown="OnEditorPreviewKeyDown" />
    </DockPanel>
</UserControl>
