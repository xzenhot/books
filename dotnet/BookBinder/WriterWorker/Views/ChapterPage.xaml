<UserControl x:Class="WriterWorker.Views.ChapterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WriterWorker.Views"
             Background="{DynamicResource EditorBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WriterWorker;component/Views/BookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:BookPageHeader Grid.Row="0"
                              Title="{Binding HeaderTitle}"
                              WindowTitle="{Binding WindowTitle}"
                              CreatedBy="{Binding CreatedBy}"
                              CreatedOn="{Binding CreatedOn}" />

        <Border Grid.Row="1" Style="{StaticResource BookToolbarStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding HeaderSubtitle}"
                           Style="{StaticResource BookSubtitleStyle}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding HeaderStats}"
                           Style="{StaticResource BookLabelStyle}"
                           Margin="0,3,0,0" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="ChapterTabs" Style="{DynamicResource VsTabControlStyle}">
            <TabItem Header="Segments">
                <DataGrid x:Name="SegmentsGrid"
                          Style="{StaticResource BookDataGridStyle}"
                          ItemsSource="{Binding Chapter.Segments}"
                          MouseDoubleClick="SegmentsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" Width="*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                        <DataGridTextColumn Header="Words" Binding="{Binding WordCount}" Width="80" />
                        <DataGridTextColumn Header="Target" Binding="{Binding WordTarget}" Width="80" />
                        <DataGridTextColumn Header="Text" Binding="{Binding TextSource}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Chapter text">
                <TextBox x:Name="ChapterTextBox" Style="{StaticResource BookTextStyle}" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{StaticResource BookStatusBarStyle}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Directory}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
