<UserControl x:Class="WriterWorker.Views.BookPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource EditorBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WriterWorker;component/Views/BookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="14,12,14,10">
           
                <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource BookTitleStyle}"
                       FontSize="19"
                       TextWrapping="Wrap" />
           

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle, ElementName=Root}"
                               Style="{StaticResource BookKindStyle}" />
                </Border>

                <TextBlock Text="Created by:" Style="{StaticResource BookLabelStyle}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding CreatedBy, ElementName=Root}"
                           Style="{StaticResource BookMetaValueStyle}"
                           Margin="5,0,0,0" />

                <TextBlock Text="Created on:" Style="{StaticResource BookLabelStyle}" Margin="20,0,0,0" />
                <TextBlock Text="{Binding CreatedOn, ElementName=Root}"
                           Style="{StaticResource BookMetaValueStyle}"
                           Margin="5,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource PanelBorderBrush}" />
    </Grid>
</UserControl>
