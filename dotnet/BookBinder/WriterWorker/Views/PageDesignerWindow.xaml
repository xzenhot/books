<Window x:Class="WriterWorker.Views.PageDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WriterWorker.Ctl"
        Title="Design page"
        Width="700"
        Height="760"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource EditorBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WriterWorker;component/Views/BookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource PanelBorderBrush}">
            <StackPanel>
                <TextBlock x:Name="PageTitleText"
                           Style="{StaticResource BookTitleStyle}"
                           Text="Title page" />
                <TextBlock x:Name="PagePathText"
                           Style="{StaticResource BookLabelStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ctl:RichTextToolbar x:Name="Toolbar"
                             Grid.Row="1"
                             Target="{Binding ElementName=Editor}" />

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SideBarBrush}">
            <!-- The sheet is the page of the book at its printed size, so the design is laid out
                 exactly as it prints and the margin of the page is the padding of the editor. -->
            <Border x:Name="PageSheet"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="White"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <RichTextBox x:Name="Editor"
                             AcceptsTab="True"
                             AllowDrop="True"
                             SpellCheck.IsEnabled="True"
                             Background="White"
                             Foreground="#FF1A1A1A"
                             CaretBrush="#FF1A1A1A"
                             SelectionBrush="#553B82F6"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Top" />
            </Border>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="16,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource PanelBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Style="{StaticResource BookLabelStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"
                           Text="Design the page, then save it as an RTF file next to the book." />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton"
                            Content="Starter text"
                            Style="{StaticResource BookButtonStyle}"
                            ToolTip="Replace the page with the starter text built from the book details"
                            Click="Reset_Click" />
                    <Button Content="Cancel"
                            Style="{StaticResource BookButtonStyle}"
                            IsCancel="True"
                            Click="Cancel_Click" />
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Style="{StaticResource BookButtonStyle}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
