<UserControl x:Class="WriterWorker.Views.BookListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WriterWorker.Views"
             Background="{DynamicResource EditorBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WriterWorker;component/Views/BookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:BookPageHeader Grid.Row="0"
                              Title="{Binding HeaderTitle}"
                              WindowTitle="{Binding WindowTitle}"
                              CreatedBy="{Binding CreatedBy}"
                              CreatedOn="{Binding CreatedOn}" />

        <TabControl Grid.Row="1" Style="{DynamicResource VsTabControlStyle}">

            <TabItem Header="Pipeline">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource BookToolbarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Pipeline folder"
                                       Style="{StaticResource BookLabelStyle}"
                                       Margin="0,0,10,0" />

                            <TextBox Grid.Column="1"
                                     x:Name="RootBox"
                                     Style="{StaticResource BookInputStyle}"
                                     Text="{Binding RootFolderText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="RootBox_KeyDown" />

                            <Button Grid.Column="2"
                                    Content="Browse..."
                                    Style="{StaticResource BookButtonStyle}"
                                    Click="Browse_Click" />
                            <Button Grid.Column="3"
                                    Content="Refresh"
                                    Style="{StaticResource BookButtonStyle}"
                                    Click="Refresh_Click" />
                            <Button Grid.Column="4"
                                    Content="Open"
                                    Style="{StaticResource BookButtonStyle}"
                                    Click="Open_Click" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="BooksGrid"
                              Style="{StaticResource BookDataGridStyle}"
                              ItemsSource="{Binding Reader.Books}"
                              SelectedItem="{Binding Reader.SelectedBook, Mode=TwoWay}"
                              MouseDoubleClick="BooksGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Book" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderName}" Width="130" />
                            <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="110" />
                            <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="110" />
                            <DataGridTextColumn Header="Chapters" Binding="{Binding ChapterCount}" Width="80" />
                            <DataGridTextColumn Header="Segments" Binding="{Binding SegmentCount}" Width="80" />
                            <DataGridTextColumn Header="Plan" Binding="{Binding PlanState}" Width="70" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource BookStatusBarStyle}">
                        <Grid>
                            <TextBlock Text="{Binding Reader.Status}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="Double-click a book to open it"
                                       Style="{StaticResource BookLabelStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Published">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource BookToolbarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Published folder"
                                       Style="{StaticResource BookLabelStyle}"
                                       Margin="0,0,10,0" />

                            <TextBox Grid.Column="1"
                                     x:Name="PublishedRootBox"
                                     Style="{StaticResource BookInputStyle}"
                                     Text="{Binding PublishedRootFolderText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="PublishedRootBox_KeyDown" />

                            <Button Grid.Column="2"
                                    Content="Browse..."
                                    Style="{StaticResource BookButtonStyle}"
                                    Click="PublishedBrowse_Click" />
                            <Button Grid.Column="3"
                                    Content="Refresh"
                                    Style="{StaticResource BookButtonStyle}"
                                    Click="PublishedRefresh_Click" />
                            <Button Grid.Column="4"
                                    Content="Open"
                                    Style="{StaticResource BookButtonStyle}"
                                    Click="PublishedOpen_Click" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="PublishedGrid"
                              Style="{StaticResource BookDataGridStyle}"
                              ItemsSource="{Binding PublishedReader.Editions}"
                              SelectedItem="{Binding PublishedReader.SelectedEdition, Mode=TwoWay}"
                              MouseDoubleClick="PublishedGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Book" Binding="{Binding BookName}" Width="150" />
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="90" />
                            <DataGridTextColumn Header="Published" Binding="{Binding PublishedAt}" Width="150" />
                            <DataGridTextColumn Header="Chapters" Binding="{Binding ChapterCount}" Width="80" />
                            <DataGridTextColumn Header="Latest" Binding="{Binding IsLatest}" Width="60" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="240" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource BookStatusBarStyle}">
                        <Grid>
                            <TextBlock Text="{Binding PublishedReader.Status}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Left" />
                            <TextBlock Text="Double-click an edition to open it"
                                       Style="{StaticResource BookLabelStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
