<UserControl x:Class="WriterWorker.Views.BookViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WriterWorker.Views"
             xmlns:ctl="clr-namespace:WriterWorker.Ctl"
             Background="{DynamicResource EditorBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WriterWorker;component/Views/BookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:BookPageHeader Grid.Row="0"
                              Title="{Binding HeaderTitle}"
                              WindowTitle="{Binding WindowTitle}"
                              CreatedBy="{Binding CreatedBy}"
                              CreatedOn="{Binding CreatedOn}" />

        <Border Grid.Row="1" Style="{StaticResource BookToolbarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding HeaderSubtitle}"
                           Style="{StaticResource BookSubtitleStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding HeaderStats}"
                           Style="{StaticResource BookLabelStyle}"
                           Margin="0,3,0,0" />

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="ContentSourceBox"
                              Width="124"
                              Height="24"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource EditorBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource PanelBorderBrush}"
                              ToolTip="Pipeline folder the book design page reads segment text from"
                              SelectionChanged="ContentSourceBox_SelectionChanged" />
                    <Button Content="Export PDF..."
                            Style="{StaticResource BookButtonStyle}"
                            ToolTip="Export the assembled book as a PDF file"
                            Click="ExportPdf_Click" />
                    <Button Content="Export RTF..."
                            Style="{StaticResource BookButtonStyle}"
                            Click="Export_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ctl:RichTextToolbar Grid.Row="2" Target="{Binding ElementName=BookReader}" />

        <RichTextBox Grid.Row="3"
                     x:Name="BookReader"
                     IsReadOnly="False"
                     AcceptsTab="True"
                     IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource EditorBackgroundBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderThickness="0"
                     Padding="14,10"
                     FontFamily="Segoe UI"
                     FontSize="13"
                     SelectionBrush="{DynamicResource SelectionBrush}"
                     TextChanged="BookReader_TextChanged" />

        <Border Grid.Row="4" Style="{StaticResource BookStatusBarStyle}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding EditStatus}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding FolderPath}"
                           Style="{StaticResource BookLabelStyle}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border x:Name="ProgressHost"
                Grid.Row="5"
                Style="{StaticResource BookStatusBarStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProgressText"
                           Grid.Column="0"
                           Style="{StaticResource BookLabelStyle}"
                           HorizontalAlignment="Left"
                           Margin="0,0,12,0" />
                <ProgressBar x:Name="ExportProgressBar"
                             Grid.Column="1"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource EditorBackgroundBrush}"
                             BorderThickness="0"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
