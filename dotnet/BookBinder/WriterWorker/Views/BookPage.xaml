<UserControl x:Class="WriterWorker.Views.BookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WriterWorker.Views"
             Background="{DynamicResource EditorBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WriterWorker;component/Views/BookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:BookPageHeader Grid.Row="0"
                              Title="{Binding HeaderTitle}"
                              WindowTitle="{Binding WindowTitle}"
                              CreatedBy="{Binding CreatedBy}"
                              CreatedOn="{Binding CreatedOn}" />

        <Border Grid.Row="1" Style="{StaticResource BookToolbarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding HeaderSubtitle}"
                           Style="{StaticResource BookSubtitleStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding HeaderStats}"
                           Style="{StaticResource BookLabelStyle}"
                           Margin="0,3,0,0" />

                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Content="Design Book"
                        Style="{StaticResource BookButtonStyle}"
                        VerticalAlignment="Center"
                        Click="BookPage_Click" />
                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                        Content="Refresh"
                        Style="{StaticResource BookButtonStyle}"
                        VerticalAlignment="Center"
                        Click="Refresh_Click" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Style="{DynamicResource VsTabControlStyle}">
            <TabItem Header="Chapters">
                <DataGrid x:Name="ChaptersGrid"
                          Style="{StaticResource BookDataGridStyle}"
                          ItemsSource="{Binding Book.Chapters}"
                          MouseDoubleClick="ChaptersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" Width="*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Words" Binding="{Binding WordCount}" Width="80" />
                        <DataGridTextColumn Header="Target" Binding="{Binding WordTarget}" Width="80" />
                        <DataGridTextColumn Header="Segments" Binding="{Binding Segments.Count}" Width="80" />
                        <DataGridTextColumn Header="Done" Binding="{Binding IsCompleted}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Documents">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             x:Name="DocumentsList"
                             ItemsSource="{Binding DocumentNames}"
                             Background="{DynamicResource SideBarBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource PanelBorderBrush}"
                             BorderThickness="0,0,1,0"
                             SelectionChanged="DocumentsList_SelectionChanged" />

                    <GridSplitter Grid.Column="1"
                                  Width="1"
                                  HorizontalAlignment="Center"
                                  Background="{DynamicResource PanelBorderBrush}" />

                    <TextBox Grid.Column="2"
                             x:Name="DocumentText"
                             Style="{StaticResource BookTextStyle}"
                             FontFamily="Consolas" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{StaticResource BookStatusBarStyle}">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BookLabelStyle}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding FolderPath}"
                           Style="{StaticResource BookLabelStyle}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
